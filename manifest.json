{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.7",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://steam.2cstudio.app",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://steam.2cstudio.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steam.2cstudio.app/*"
      ],
      "js": [
        "i18n.js",
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/*"
      ],
      "js": [
        "steam-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/*"
      ],
      "js": [
        "lib.js",
        "i18n.js",
        "steam.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/id/*/inventory*",
        "https://steamcommunity.com/profiles/*/inventory*"
      ],
      "js": [
        "inventory-cta.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
